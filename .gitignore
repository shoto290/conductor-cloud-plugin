# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnp.*
# dist/index.js is committed on purpose: Cursor installs this plugin by cloning
# the repo, and never runs npm install. A tracked, dependency-free bundle is
# what lets the server start from Customize with nothing but an API key set.
dist/*
!dist/index.js
build/
coverage/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Keys and secrets
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
secrets/
*.secret

# Conductor
.conductor/

# Claude Code — .claude/settings.json is committed, personal overrides are not
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
*.swp
